# Clés API --- copiez ce fichier en .env et remplissez les vraies valeurs.
# Ne commitez jamais le fichier .env.

# Clé API OpenAI ChatGPT
OPENAI_API_KEY=

# Modèle à utiliser (optionnel, défaut : gpt-4o-mini)
OPEAI_MODEL=gpt-4o-mini

# Clés Supabase --- le préfixe EXPO_PUBLIC_ est nécessaire pour qu'Expo
# les rende accessibles côté client (l'anon key est prévue pour ça,
# la sécurité repose sur les Row Level Security policies côté Supabase).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
